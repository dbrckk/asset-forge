        "mesh-optimization",
        "gltf"
      ],
      "automation": [
        "cli",
        "library"
      ],
      "outputs": [
        "optimized-mesh",
        "glb"
      ],
      "license": "MIT"
    },
    {
      "id": "pixelorama",
      "name": "Pixelorama",
      "status": "candidate",
